# OpsMesh Controlplane Dockerfile
FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o opsmesh ./cmd/opsmesh

FROM alpine:3.19
RUN apk --no-cache add ca-certificates curl
COPY --from=builder /app/opsmesh /usr/local/bin/opsmesh
EXPOSE 8080 9090 9091
ENTRYPOINT ["opsmesh"]
