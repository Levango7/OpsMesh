# Generic Dockerfile for OpsMesh Go microservices
# Legacy template — superseded by per-service Dockerfiles (services/<svc>/Dockerfile).
# Build (per service, e.g. auth-svc): docker build -f services/auth-svc/Dockerfile -t opsmesh/auth-svc services/auth-svc
FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o svc ./cmd/*/

FROM alpine:3.23
RUN apk --no-cache add ca-certificates curl
COPY --from=builder /app/svc /usr/local/bin/svc
EXPOSE 8100
ENTRYPOINT ["svc"]
