# OpsMesh 反向代理网关（TLS 终止）——nginx 配置模板
#
# 由官方 nginx 镜像的 docker-entrypoint.d/20-envsubst-on-templates.sh 在容器启动时
# 渲染：/etc/nginx/templates/*.template → /etc/nginx/conf.d/*.conf。
# envsubst 只替换「环境中已定义」的变量，因此 nginx 自身的 $host/$remote_addr 等不受影响。
#
# 可用变量（在 docker-compose.prod-proxy.yml 中设置）：
#   GATEWAY_SERVER_NAME    server_name（默认 _，即接受任意 Host；生产建议填真实域名）
#   GATEWAY_PUBLIC_ORIGIN  对外访问源，形如 https://ops.example.com 或 https://ops.example.com:8443。
#                          用于 HTTP→HTTPS 跳转。不能写作 $host（不含端口）——网关改用
#                          非 443 端口时（宿主机 80/443 被占用）跳转会丢掉端口指向错误地址。
#                          该值与控制面 OPSMESH_ADVERTISE_ADDR 同源，避免两处漂移。
#
# 注意：nginx 的 proxy_set_header 不跨层继承——某个 location 内只要定义了任意一条
# proxy_set_header，server 块里的全部 proxy_set_header 在该 location 内即失效。
# 因此下面每个 location 都完整重述转发头，不做隐式继承。

upstream opsmesh_controlplane {
    server controlplane:8080;
    keepalive 32;
}

# HTTP：仅保留跳转与网关自身健康检查（ACME 签发可解注 /.well-known 段）。
server {
    listen 80 default_server;
    server_name ${GATEWAY_SERVER_NAME};

    # 网关自身存活探针：不依赖上游控制面，避免上游故障时容器被反复重启。
    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / {
        return 301 ${GATEWAY_PUBLIC_ORIGIN}$request_uri;
    }
}

# HTTPS：终止 TLS 后转发到控制面明文端口（OPSMESH_HTTP_TLS=off 形态）。
server {
    listen 443 ssl;
    http2 on;
    server_name ${GATEWAY_SERVER_NAME};

    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 控制面已按 production 发送安全头；此处补网关层兜底。
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # agent 二进制经 /bin/opsmesh-agent 分发，需允许大响应体与流式转发。
    client_max_body_size 512m;
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;
    proxy_request_buffering off;

    # 常规请求：Web 控制台、REST API、/install.sh、/bin/opsmesh-agent。
    location / {
        proxy_pass http://opsmesh_controlplane;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";
    }

    # SSE 实时推送（/api/v1/events/stream）：必须关闭缓冲，否则事件被攒在网关缓冲里，
    # 前端长时间收不到推送；读超时放到 24h 以覆盖长连接。
    location = /api/v1/events/stream {
        proxy_pass http://opsmesh_controlplane;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        chunked_transfer_encoding off;
    }
}
