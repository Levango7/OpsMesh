# OpsMesh ControlPlane 环境变量模板
# 部署：拷贝到 /etc/opsmesh/opsmesh-controlplane.env 并按实际环境修改
# 由 opsmesh-controlplane.service 通过 EnvironmentFile 加载
# 安装：install -d -m 0750 /etc/opsmesh && install -m 0640 $PWD/opsmesh-controlplane.env /etc/opsmesh/

# 存储后端：memory | mysql（生产建议 mysql，memory 仅用于本地测试）
OPSMESH_STORE=mysql

# MySQL DSN（go-sql-driver/mysql 格式）
# 生产环境请替换为实际 MySQL 地址、账号、密码，并建议开启 TLS（追加 tls=true 参数）
OPSMESH_MYSQL_DSN=opsmesh:opsmesh@tcp(127.0.0.1:3306)/opsmesh?parseTime=true

# Redis 地址（缓存/会话/消息）
OPSMESH_REDIS_ADDR=127.0.0.1:6379

# 生产模式开关（开启后启用更严格的运行时检查、日志级别等）
OPSMESH_PRODUCTION=true

# 强制鉴权（API/控制面访问需携带凭证）
OPSMESH_REQUIRE_AUTH=true

# TLS 证书路径（启用 HTTPS/gRPC over TLS，证书需由 opsmesh 用户可读）
OPSMESH_TLS_CERT=/etc/opsmesh/tls/server.crt
OPSMESH_TLS_KEY=/etc/opsmesh/tls/server.key

# 对外通告地址（集群内其他节点/agent 连接控制面的地址，生产应改为实际可达地址）
OPSMESH_ADVERTISE_ADDR=http://0.0.0.0:8080

# JWT 签发密钥（HS256，生产须一致）。生产必须注入，否则 OPSMESH_PRODUCTION=true 启动被 Validate 拒绝。
# 生成：openssl rand -hex 32
OPSMESH_JWT_SECRET=

# ── 安全相关配置（config.go flag 环境变量映射）──
# 以下为安全加固项，生产环境建议按实际开启；未列出的项使用代码侧默认值。

# Cookie Secure 标志（task 112，--cookie-secure）：控制 at/rt HttpOnly Cookie 的 Secure 属性。
# true=Cookie 仅经 HTTPS 传输（防中间人窃取会话）；false=Cookie 亦经 HTTP 传输。
# 生产模式（OPSMESH_PRODUCTION=true）下代码侧默认 true；此处可显式覆盖。
# OPSMESH_COOKIE_SECURE=true

# 公开注册开关（--public-register）：true=开放 /api/v1/auth/register 但新用户须管理员审批；
# false=关闭公开注册（仅管理员可创建用户）。生产模式默认 false（安全基线）。
# OPSMESH_PUBLIC_REGISTER=false

# 公开注册免审批（--allow-public-register）：true=注册即激活并立即签发 token（仅演示/内网受信）；
# false=所有注册走 pending 审批流程（安全基线）。生产务必 false。
# OPSMESH_ALLOW_PUBLIC_REGISTER=false

# 联邦共享 HMAC 密钥（--federation-secret）：联邦 peer 间签名/验签身份头，防跨不可信网段伪造。
# 启用联邦（OPSMESH_FEDERATION_PEERS 非空）时必填（Validate 强校验）。空=不启用联邦。
# OPSMESH_FEDERATION_SECRET=
# OPSMESH_FEDERATION_PEERS=http://peer1:8080,http://peer2:8080

# 联邦 mTLS 凭证（独立于 gRPC 的 TLS_CERT/TLS_KEY）：联邦独立 mTLS 监听端口时必填。
# OPSMESH_FEDERATION_TLS_CERT=/etc/opsmesh/federation/tls.crt
# OPSMESH_FEDERATION_TLS_KEY=/etc/opsmesh/federation/tls.key
# OPSMESH_FEDERATION_CA=/etc/opsmesh/federation/ca.crt
# OPSMESH_FEDERATION_PORT=0

# 自动纳管 install token HMAC 密钥（--provision-secret）：多副本需一致；空=本实例随机生成（仅单实例）。
# OPSMESH_PROVISION_SECRET=

# gRPC agent 身份绑定（--grpc-require-signature）：强制 agent 请求携带 HMAC 签名（防冒领任务/伪造上报）。
# demo 模式强制关闭；生产模式默认开启。显式 false 可关闭（已启用 mTLS 时可关闭）。
# OPSMESH_GRPC_REQUIRE_SIGNATURE=true

# 信任反向代理（--trust-proxy）：开启后 clientIP 取 X-Forwarded-For 首段。
# 默认 false=仅用 RemoteAddr 防 XFF 伪造绕过限流。仅当有可信 LB/网关前置时启用。
# OPSMESH_TRUST_PROXY=false

# JWT 验签公钥（--jwt-public-key，RS256）：网关剥离 + 内核二次校验的纵深防御。空=关闭回退头注入。
# OPSMESH_JWT_PUBLIC_KEY=/etc/opsmesh/jwt/public.pem
# OPSMESH_JWT_ISSUER=opsmesh

# mTLS 客户端 CA（--client-ca）：服务端要求客户端持证。生产强 TLS 场景建议配置。
# OPSMESH_CLIENT_CA=/etc/opsmesh/tls/ca.crt

# metrics 访问控制（--metrics-allow-cidr）：CIDR 白名单，空=不限制。生产建议配置内网监控网段。
# OPSMESH_METRICS_ALLOW_CIDR=10.0.0.0/8