# MySQL Custom Configuration for OpsMesh Production
# Optimized for InnoDB with production workloads

[mysqld]
# Connection Settings
max_connections = 500
max_connect_errors = 100000
wait_timeout = 600
interactive_timeout = 600

# InnoDB Settings
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 4
# 2026-10-07 更正：原先写的是 `innodb_log_file_size = 256M`，该键在 MySQL 8.0.30+ 已被
# `innodb_redo_log_capacity` 取代并**静默失效**——实测（mysqld 8.0.46 挂载本文件后
# `SELECT @@innodb_redo_log_capacity`）仍是默认 100M，也就是"以为调过了但没调"。
# 这里按原意图（256M）改用生效的键。
innodb_redo_log_capacity = 256M
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_purge_threads = 4
innodb_thread_concurrency = 0

# Query Cache (MySQL 8.0 deprecated, but kept for reference)
# query_cache_type = 0
# query_cache_size = 0

# Temporary Tables
tmp_table_size = 128M
max_heap_table_size = 128M

# Logging
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
# 2026-10-07 更正：删掉原先的 `log_error = /var/lib/mysql/error.log`。
# 把错误日志重定向到文件后，容器里 `docker logs opsmesh-mysql` **一行 mysqld 报错都没有**——
# 这不是理论问题：本机一次容器启动失败（exit 1）时控制台完全静默，只能 docker cp 把
# error.log 取出来才看到根因。留给 stderr 才符合"容器日志就是 stdout/stderr"的惯例，
# 也让 compose 的日志驱动/外部采集能收到。verbosity 保留（对 stderr sink 同样生效）。
log_error_verbosity = 3

# Binary Logging (for replication)
server-id = 1
log_bin = /var/lib/mysql/mysql-bin
binlog_format = ROW
binlog_expire_logs_seconds = 604800
max_binlog_size = 256M
sync_binlog = 1

# Character Set
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# Security
local_infile = 0
skip_symbolic_links = yes

# Performance Schema
performance_schema = ON
performance_schema_instrument = '%=ON'

[client]
default_character_set = utf8mb4

[mysql]
default_character_set = utf8mb4
