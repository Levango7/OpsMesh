[
  {
    "name": "allow-basic",
    "policies": [
      {"id": "p-allow", "subject": "alice", "resource": "vm:1", "action": "read", "effect": "allow"}
    ],
    "subject": "alice",
    "resource": "vm:1",
    "action": "read",
    "context": "",
    "expected": {"allowed": true, "matchedPolicyID": "p-allow", "denyOverride": false}
  },
  {
    "name": "no-match-default-deny",
    "policies": [
      {"id": "p-allow", "subject": "alice", "resource": "vm:1", "action": "read", "effect": "allow"}
    ],
    "subject": "bob",
    "resource": "vm:1",
    "action": "read",
    "context": "",
    "expected": {"allowed": false, "matchedPolicyID": "", "denyOverride": false}
  },
  {
    "name": "empty-policies-default-deny",
    "policies": [],
    "subject": "alice",
    "resource": "*",
    "action": "*",
    "context": "{}",
    "expected": {"allowed": false, "matchedPolicyID": "", "denyOverride": false}
  },
  {
    "name": "deny-overrides-allow",
    "policies": [
      {"id": "p-allow-all", "subject": "*", "resource": "*", "action": "*", "effect": "allow"},
      {"id": "p-deny-prod", "subject": "*", "resource": "vm:prod-1", "action": "*", "effect": "deny"}
    ],
    "subject": "bob",
    "resource": "vm:prod-1",
    "action": "write",
    "context": "",
    "expected": {"allowed": false, "matchedPolicyID": "p-deny-prod", "denyOverride": true}
  },
  {
    "name": "deny-overrides-allow-deny-listed-first",
    "policies": [
      {"id": "p-deny-prod", "subject": "*", "resource": "vm:prod-1", "action": "*", "effect": "deny"},
      {"id": "p-allow-all", "subject": "*", "resource": "*", "action": "*", "effect": "allow"}
    ],
    "subject": "bob",
    "resource": "vm:prod-1",
    "action": "write",
    "context": "",
    "expected": {"allowed": false, "matchedPolicyID": "p-deny-prod", "denyOverride": true}
  },
  {
    "name": "deny-condition-not-met-falls-through-to-allow",
    "policies": [
      {"id": "p-allow-all", "subject": "*", "resource": "*", "action": "*", "effect": "allow"},
      {"id": "p-deny-prod", "subject": "*", "resource": "*", "action": "*", "effect": "deny", "conditions": {"env": "production"}}
    ],
    "subject": "bob",
    "resource": "vm:1",
    "action": "write",
    "context": "{\"env\":\"staging\"}",
    "expected": {"allowed": true, "matchedPolicyID": "p-allow-all", "denyOverride": false}
  },
  {
    "name": "condition-match-string",
    "policies": [
      {"id": "p-cond", "subject": "alice", "resource": "*", "action": "write", "effect": "allow", "conditions": {"env": "staging"}}
    ],
    "subject": "alice",
    "resource": "vm:1",
    "action": "write",
    "context": "{\"env\":\"staging\",\"extra\":\"ignored\"}",
    "expected": {"allowed": true, "matchedPolicyID": "p-cond", "denyOverride": false}
  },
  {
    "name": "condition-mismatch",
    "policies": [
      {"id": "p-cond", "subject": "alice", "resource": "*", "action": "write", "effect": "allow", "conditions": {"env": "staging"}}
    ],
    "subject": "alice",
    "resource": "vm:1",
    "action": "write",
    "context": "{\"env\":\"production\"}",
    "expected": {"allowed": false, "matchedPolicyID": "", "denyOverride": false}
  },
