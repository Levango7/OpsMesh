# Dockerfile.service — 微服务统一构建模板（release job 用）。
#
# 背景（release 首跑实测）：services/<svc> 是独立 go.mod 模块且全部
# replace opsmesh => ../../ 引用主模块——单服务目录作构建上下文时容器内
# 无主模块，go mod verify 直接报 "replaced by ../../: open /go.mod: no
# such file"。因此本模板必须以【仓库根】为构建上下文（release.yml 已设
# context: .），服务名经 --build-arg SERVICE 注入，编译 ./services/<svc>。
#
# base image digest 由 Renovate 自动钉死（.github/renovate.json）。
FROM golang:1.26-bookworm AS build
ARG SERVICE=auth-svc
ARG VERSION=dev
ENV GOPROXY=https://goproxy.cn,direct
# 关键：golang 官方镜像默认 WORKDIR=/go（即 GOPATH）。若不先切换 WORKDIR，
# 下方 COPY ./ 会把 go.mod 写进 GOPATH（第 4 轮实测报 "warning: ignoring
# go.mod in $GOPATH /go"），且 WORKDIR /src/services/<svc> 随后是空目录
# （"go.mod file not found"）。必须先落地 /src 再 COPY。
WORKDIR /src
# 主模块 + 全部服务 go.mod 先行复制，使各模块 replace 解析可用。
#
# 只 COPY go.work，**不 COPY go.work.sum**（2026-09-26 实测修复）：go.work.sum 由
# .gitignore 显式排除（自动生成、不入库），干净检出里根本不存在它，而 COPY 一个不
# 存在的文件会让**每一次微服务镜像构建直接失败**：
#   ERROR: failed to build: failed to solve: failed to compute cache key:
#   "/go.work.sum": not found
# 后果已发生：release run 35129758414（tag v0.9.1）18 条矩阵全红/被取消 →
# GHCR 上至今没有 0.9.1 的微服务镜像（实测 levango7/auth-svc 的 tag 集只有
# 0.8.0 / 0.9.0 / latest / <sha>，无 0.9.1）。
# 不入库的依赖校验并未因此丢失：各模块自己的 go.sum 仍在（下方 COPY），
# `go mod download` 在 workspace 模式下会自行生成 go.work.sum。
# 反证：CI 的 services job 在同样的干净检出（无 go.work.sum）下对 17 个模块逐个
# `go build ./...` 全绿——workspace 无 sum 文件可正常构建。
COPY go.work ./
COPY go.mod go.sum ./
COPY operator/ operator/
COPY pkg/ pkg/
COPY internal/ internal/
COPY services/ services/
# go.work 位于 /src，从服务目录向上回溯即可命中，workspace 模式下依赖
# 解析全部走 go.work，不依赖 GOPATH 内的模块缓存。
WORKDIR /src/services/${SERVICE}
# M11 供应链安全：go mod verify 校验模块完整性（防 go.sum 漂移 / 投毒）。
# workspace 模式下 download 拉取所有 workspace 模块依赖，verify 校验哈希。
RUN go mod download && go mod verify
# 注意：-X 的包路径必须是模块路径（github.com/Levango7/OpsMesh/...）。写成 opsmesh/...
# 时链接器会**静默忽略**（构建成功但版本注入不生效，2026-09-26 实测确认，产物仍报默认值）。
# 注释不得写在 RUN 续行中间：Dockerfile 解析器会在注释处截断该指令。
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X github.com/Levango7/OpsMesh/internal/version.Version=${VERSION}" \
    -o /svc ./cmd/${SERVICE}

# P2-2 供应链安全：base image digest 由 Renovate 自动钉死（见 .github/renovate.json）。
# 手动钉死：crane digest alpine:3.23 → FROM alpine:3.23@sha256:<digest> AS runtime
FROM alpine:3.23 AS runtime
RUN apk --no-cache upgrade && apk --no-cache add ca-certificates curl
# 非 root 运行（H16 基线）：与仓库根 Dockerfile 的 nonroot 语义一致。
RUN addgroup -S svc && adduser -S svc -G svc
USER svc
COPY --from=build /svc /usr/local/bin/svc
EXPOSE 8080
CMD ["svc"]
