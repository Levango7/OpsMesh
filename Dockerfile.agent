# OpsMesh Agent 镜像（U-05 agent 角色）。
# agent 需 sh -c 执行 shell/service 任务（如调用系统命令、跑脚本），
# 故 runtime 必须含 /bin/sh。注意：gcr.io/distroless/base-debian12 官方
# 明确"不含 shell"（/bin/sh 不存在），此前用它导致 exec.Command("sh",...)
# 启动失败（exitCode=-1，任务全部立即失败）——改用 debian:bookworm-slim
# （含完整 sh），仍以非 root（UID 65532）运行保持最小权限。
# 多阶段构建：build 阶段拉取依赖并编译静态二进制，runtime 阶段用精简镜像。
# syntax=docker/dockerfile:1.6
# P2-2 供应链安全：base image digest 由 Renovate 自动钉死（见 .github/renovate.json）。
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /opsmesh ./cmd/opsmesh

FROM debian:bookworm-slim AS runtime
# 非 root 运行（与 distroless 的 nonroot 用户同 UID 65532，保持最小权限）。
# 注意：USER 后不能再有需要 root 的 COPY（chown 在此完成）。
COPY --chown=65532:65532 --from=build /opsmesh /usr/local/bin/opsmesh
USER 65532:65532
# agent 默认以 agent 模式启动；--control-addr 等参数由 deployment args 覆盖。
ENTRYPOINT ["/usr/local/bin/opsmesh"]
CMD ["--mode=agent"]