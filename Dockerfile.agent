# OpsMesh Agent 镜像（U-05 agent 角色）。
# agent 需 sh -c 执行 shell/service 任务（如调用系统命令、跑脚本），
# 故 runtime 必须含 /bin/sh。注意：gcr.io/distroless/base-debian12 官方
# 明确"不含 shell"（/bin/sh 不存在），此前用它导致 exec.Command("sh",...)
# 启动失败（exitCode=-1，任务全部立即失败）——改用 debian:bookworm-slim
# （含完整 sh），仍以非 root（UID 65532）运行保持最小权限。
# S10 安全决策：agent 需 /bin/sh 执行 shell 任务，distroless（static/base）均
# 不含 shell，故保留 debian:bookworm-slim；通过 S5 apt-get upgrade 修复 CVE、
# 非 root 运行 + drop ALL capabilities 缩小攻击面（见 builders.go agentDaemonSet）。
# 多阶段构建：build 阶段拉取依赖并编译静态二进制，runtime 阶段用精简镜像。
# syntax=docker/dockerfile:1.6
# P2-2 供应链安全：base image digest 由 Renovate 自动钉死（见 .github/renovate.json）。
FROM golang:1.26-bookworm AS build
# 国内网络环境 proxy.golang.org 不可达，走 goproxy.cn 公共代理（CI 同样可用）。
ENV GOPROXY=https://goproxy.cn,direct
# GOWORK=off：同 Dockerfile——go.work 引用被 dockerignore 排除的 operator/services
# 模块，容器内按单模块构建（主模块 go.mod 自洽）。
ENV GOWORK=off
WORKDIR /src
COPY go.mod go.sum ./
# M11 供应链安全：go mod verify 校验下载模块完整性（防 go.sum 漂移 / 投毒）。
RUN go mod download && go mod verify
COPY . .
# 同根 Dockerfile：注入构建元信息（P1-6 /version）；-X 包路径必须是模块路径。
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath     -ldflags="-s -w -X github.com/Levango7/OpsMesh/internal/version.Version=${VERSION} -X github.com/Levango7/OpsMesh/internal/version.Commit=${COMMIT} -X github.com/Levango7/OpsMesh/internal/version.Date=${BUILD_DATE}"     -o /opsmesh ./cmd/opsmesh

# P2-2 供应链安全：base image digest 由 Renovate 自动钉死（见 .github/renovate.json）。
# 手动钉死：crane digest debian:bookworm-slim → FROM debian:bookworm-slim@sha256:<digest> AS runtime
FROM debian:bookworm-slim AS runtime
# S5 供应链安全：apt-get upgrade 升级基础包修复已知 CVE（debian-slim 基础镜像
# 可能携带过期包）。在 USER 切换前以 root 执行；agent 二进制静态编译
# （CGO_ENABLED=0）无需额外 apt install，仅 upgrade 已有包。
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
# 非 root 运行（与 distroless 的 nonroot 用户同 UID 65532，保持最小权限）。
# 注意：USER 后不能再有需要 root 的 COPY（chown 在此完成）。
COPY --chown=65532:65532 --from=build /opsmesh /usr/local/bin/opsmesh
USER 65532:65532
# agent 默认以 agent 模式启动；--control-addr 等参数由 deployment args 覆盖。
ENTRYPOINT ["/usr/local/bin/opsmesh"]
CMD ["--mode=agent"]